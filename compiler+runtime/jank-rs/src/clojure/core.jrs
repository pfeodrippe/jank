;; clojure.core - Core library for jank-rs
;;
;; This file provides the fundamental functions and macros similar to
;; Clojure's clojure.core. It builds upon the native functions provided
;; by the Rust runtime.
;;
;; BOOTSTRAP SEQUENCE:
;; 1. Define type predicates using fn* (wrapping native/ functions)
;; 2. Define defmacro using def + macro (primitive)
;; 3. Define defn using defmacro
;; 4. Define fundamental functions using defn
;; 5. Define remaining macros using defmacro

(ns clojure.core)

;; ============================================================================
;; BOOTSTRAP PHASE 0: Type Predicates (using fn* to wrap native functions)
;; ============================================================================
;; These must be defined before defmacro since it uses string? and list?

(def ^{:doc "Returns true if x is nil, false otherwise."}
  nil?
  (fn* nil? [x] (native/nil? x)))

(def ^{:doc "Returns true if x is the value true, false otherwise."}
  true?
  (fn* true? [x] (native/true? x)))

(def ^{:doc "Returns true if x is the value false, false otherwise."}
  false?
  (fn* false? [x] (native/false? x)))

(def ^{:doc "Returns true if x is a Boolean."}
  boolean?
  (fn* boolean? [x] (native/boolean? x)))

(def ^{:doc "Returns true if x is a Number."}
  number?
  (fn* number? [x] (native/number? x)))

(def ^{:doc "Returns true if x is an integer."}
  integer?
  (fn* integer? [x] (native/integer? x)))

(def ^{:doc "Returns true if x is a floating point number."}
  float?
  (fn* float? [x] (native/float? x)))

(def ^{:doc "Returns true if x is a String."}
  string?
  (fn* string? [x] (native/string? x)))

(def ^{:doc "Returns true if x is a Symbol."}
  symbol?
  (fn* symbol? [x] (native/symbol? x)))

(def ^{:doc "Returns true if x is a Keyword."}
  keyword?
  (fn* keyword? [x] (native/keyword? x)))

(def ^{:doc "Returns true if x is a list."}
  list?
  (fn* list? [x] (native/list? x)))

(def ^{:doc "Returns true if x is a vector."}
  vector?
  (fn* vector? [x] (native/vector? x)))

(def ^{:doc "Returns true if x is a map."}
  map?
  (fn* map? [x] (native/map? x)))

(def ^{:doc "Returns true if x is a set."}
  set?
  (fn* set? [x] (native/set? x)))

(def ^{:doc "Returns true if x is a function."}
  fn?
  (fn* fn? [x] (native/fn? x)))

(def ^{:doc "Returns true if x is a collection (list, vector, map, or set)."}
  coll?
  (fn* coll? [x] (native/coll? x)))

(def ^{:doc "Returns true if x is a seq."}
  seq?
  (fn* seq? [x] (native/seq? x)))

(def ^{:doc "Returns true if coll has no items."}
  empty?
  (fn* empty? [x] (native/empty? x)))

(def ^{:doc "Returns true if n is even."}
  even?
  (fn* even? [x] (native/even? x)))

(def ^{:doc "Returns true if n is odd."}
  odd?
  (fn* odd? [x] (native/odd? x)))

(def ^{:doc "Returns true if n is zero."}
  zero?
  (fn* zero? [x] (native/zero? x)))

(def ^{:doc "Returns true if n is greater than zero."}
  pos?
  (fn* pos? [x] (native/pos? x)))

(def ^{:doc "Returns true if n is less than zero."}
  neg?
  (fn* neg? [x] (native/neg? x)))

;; ============================================================================
;; BOOTSTRAP PHASE 1: Define defmacro using primitive def + macro
;; ============================================================================

;; defmacro is a macro that creates macros
;; It takes: name, optional docstring, params, and body
;; and expands to: (def name (macro name params body))
(def defmacro
  (macro defmacro [name & args]
    (let [;; Check for docstring
          has-doc (string? (first args))
          doc (if has-doc (first args) nil)
          rest-args (if has-doc (rest args) args)
          ;; Check if multi-arity
          is-multi (list? (first rest-args))]
      (if is-multi
        ;; Multi-arity: (defmacro name ([p1] b1) ([p2] b2) ...)
        `(def ~name (macro ~name ~@rest-args))
        ;; Single-arity: (defmacro name [params] body)
        (let [params (first rest-args)
              body (rest rest-args)]
          (if (= (count body) 1)
            `(def ~name (macro ~name ~params ~(first body)))
            `(def ~name (macro ~name ~params (do ~@body)))))))))

;; ============================================================================
;; BOOTSTRAP PHASE 2: Define defn using defmacro
;; ============================================================================

;; defn is a macro that creates functions
;; It takes: name, optional docstring, params, and body
;; and expands to: (def name (fn name params body))
(defmacro defn
  [name & args]
  (let [;; Check for docstring
        has-doc (string? (first args))
        doc (if has-doc (first args) nil)
        rest-args (if has-doc (rest args) args)
        ;; Check if multi-arity
        is-multi (list? (first rest-args))]
    (if is-multi
      ;; Multi-arity: (defn name ([p1] b1) ([p2] b2) ...)
      `(def ~name (fn ~name ~@rest-args))
      ;; Single-arity: (defn name [params] body)
      (let [params (first rest-args)
            body (rest rest-args)]
        (if (= (count body) 1)
          `(def ~name (fn ~name ~params ~(first body)))
          `(def ~name (fn ~name ~params (do ~@body))))))))

;; ============================================================================
;; BOOTSTRAP PHASE 3: Fundamental Functions
;; ============================================================================

(defn not
  "Returns true if x is logical false, false otherwise."
  [x]
  (if x false true))

(defn identity
  "Returns its argument."
  [x]
  x)

(defn constantly
  "Returns a function that takes any number of arguments and returns x."
  [x]
  (fn [& args] x))

;; ============================================================================
;; Logical Macros (multi-arity)
;; ============================================================================

(defmacro or
  ([] nil)
  ([x] x)
  ([x & next]
   `(let [or# ~x]
      (if or# or# (or ~@next)))))

(defmacro and
  ([] true)
  ([x] x)
  ([x & next]
   `(let [and# ~x]
      (if and# (and ~@next) and#))))

;; ============================================================================
;; Control Flow Macros
;; ============================================================================

(defmacro when
  [test & body]
  (list 'if test (cons 'do body) nil))

(defmacro when-not
  [test & body]
  (list 'if (list 'not test)
        (cons 'do body)
        nil))

(defmacro cond
  [& clauses]
  (when clauses
    (list 'if (first clauses)
          (if (next clauses)
            (second clauses)
            (throw "cond requires an even number of forms"))
          (cons 'cond (next (next clauses))))))

(defmacro if-let
  ([bindings then]
   `(if-let ~bindings ~then nil))
  ([bindings then else]
   (let [form (first bindings)
         tst (second bindings)]
     `(let [temp# ~tst]
        (if temp#
          (let [~form temp#]
            ~then)
          ~else)))))

(defmacro when-let
  [bindings & body]
  (let [form (first bindings)
        tst (second bindings)]
    `(let [temp# ~tst]
       (when temp#
         (let [~form temp#]
           ~@body)))))

(defmacro if-some
  ([bindings then]
   `(if-some ~bindings ~then nil))
  ([bindings then else]
   (let [form (first bindings)
         tst (second bindings)]
     `(let [temp# ~tst]
        (if (nil? temp#)
          ~else
          (let [~form temp#]
            ~then))))))

(defmacro when-some
  [bindings & body]
  (let [form (first bindings)
        tst (second bindings)]
    `(let [temp# ~tst]
       (when (some? temp#)
         (let [~form temp#]
           ~@body)))))

;; ============================================================================
;; Threading Macros
;; ============================================================================

(defmacro ->
  [x & forms]
  (if forms
    (let [form (first forms)
          threaded (if (seq? form)
                     (list* (first form) x (rest form))
                     (list form x))]
      `(-> ~threaded ~@(rest forms)))
    x))

(defmacro ->>
  [x & forms]
  (if forms
    (let [form (first forms)
          threaded (if (seq? form)
                     (concat form (list x))
                     (list form x))]
      `(->> ~threaded ~@(rest forms)))
    x))

(defmacro as->
  [expr name & forms]
  `(let [~name ~expr
         ~@(interleave (repeat name) forms)]
     ~name))

;; ============================================================================
;; Assertion and Comment Macros
;; ============================================================================

(defmacro assert
  ([x]
   `(when-not ~x
      (throw (str "Assert failed: " '~x))))
  ([x message]
   `(when-not ~x
      (throw (str "Assert failed: " ~message)))))

(defmacro comment
  [& body]
  nil)

;; ============================================================================
;; Iteration Macros
;; ============================================================================

(defmacro dotimes
  [bindings & body]
  (let [i (first bindings)
        n (second bindings)]
    `(let [n# ~n]
       (loop [~i 0]
         (when (< ~i n#)
           ~@body
           (recur (inc ~i)))))))

(defmacro doseq
  [bindings & body]
  (let [binding-sym (first bindings)
        coll (second bindings)]
    `(loop [s# (seq ~coll)]
       (when s#
         (let [~binding-sym (first s#)]
           ~@body)
         (recur (next s#))))))

;; ============================================================================
;; Sequence Functions
;; ============================================================================

(defn second
  "Returns the second item in coll. Same as (first (next coll))."
  [coll]
  (first (next coll)))

(defn ffirst
  "Same as (first (first x))."
  [x]
  (first (first x)))

(defn nfirst
  "Same as (next (first x))."
  [x]
  (next (first x)))

(defn fnext
  "Same as (first (next x))."
  [x]
  (first (next x)))

(defn nnext
  "Same as (next (next x))."
  [x]
  (next (next x)))

(defn last
  "Returns the last item in coll, in linear time."
  [coll]
  (if (next coll)
    (recur (next coll))
    (first coll)))

(defn not-empty
  "If coll is empty, returns nil, else coll."
  [coll]
  (if (empty? coll) nil coll))

;; ============================================================================
;; Higher-Order Functions using loop/recur
;; ============================================================================

(defn map
  "Returns a vector consisting of the result of applying f to
  the first item in coll, followed by applying f to the second item, etc."
  [f coll]
  (loop [result []
         remaining coll]
    (if (empty? remaining)
      result
      (recur (conj result (f (first remaining)))
             (rest remaining)))))

(defn mapv
  "Returns a vector consisting of the result of applying f to the
  set of first items of each coll, followed by applying f to the set
  of second items in each coll, until any one of the colls is exhausted."
  [f coll]
  (vec (map f coll)))

(defn filter
  "Returns a vector of the items in coll for which
  (pred item) returns logical true."
  [pred coll]
  (loop [result []
         remaining coll]
    (if (empty? remaining)
      result
      (let [item (first remaining)]
        (recur (if (pred item)
                 (conj result item)
                 result)
               (rest remaining))))))

(defn filterv
  "Returns a vector of the items in coll for which
  (pred item) returns logical true."
  [pred coll]
  (vec (filter pred coll)))

(defn remove
  "Returns a vector of the items in coll for which
  (pred item) returns logical false."
  [pred coll]
  (filter (complement pred) coll))

(defn reduce
  "f should be a function of 2 arguments. If val is not supplied,
  returns the result of applying f to the first 2 items in coll, then
  applying f to that result and the 3rd item, etc. If coll contains no
  items, f must accept no arguments as well, and reduce returns the
  result of calling f with no arguments. If val is supplied, returns the
  result of applying f to val and the first item in coll, then applying
  f to that result and the 2nd item, etc."
  ([f coll]
   (if (empty? coll)
     (f)
     (reduce f (first coll) (rest coll))))
  ([f init coll]
   (loop [result init
          remaining coll]
     (if (empty? remaining)
       result
       (recur (f result (first remaining))
              (rest remaining))))))

(defn some
  "Returns the first logical true value of (pred x) for any x in coll,
  else nil. One common idiom is to use a set as pred, for example
  this will return :fred if :fred is in the sequence, otherwise nil:
  (some #{:fred} coll)"
  [pred coll]
  (loop [remaining coll]
    (if (empty? remaining)
      nil
      (let [result (pred (first remaining))]
        (if result
          result
          (recur (rest remaining)))))))

(defn every?
  "Returns true if (pred x) is logical true for every x in coll, else false."
  [pred coll]
  (loop [remaining coll]
    (if (empty? remaining)
      true
      (if (pred (first remaining))
        (recur (rest remaining))
        false))))

(defn not-every?
  "Returns false if (pred x) is logical true for every x in coll, else true."
  [pred coll]
  (not (every? pred coll)))

(defn not-any?
  "Returns false if (pred x) is logical true for any x in coll, else true."
  [pred coll]
  (not (some pred coll)))

(defn keep
  "Returns a vector of the non-nil results of (f item). Note,
  this means false return values will be included."
  [f coll]
  (loop [result []
         remaining coll]
    (if (empty? remaining)
      result
      (let [v (f (first remaining))]
        (recur (if (nil? v) result (conj result v))
               (rest remaining))))))

(defn map-indexed
  "Returns a vector consisting of the result of applying f to 0
  and the first item of coll, followed by applying f to 1 and the second
  item in coll, etc, until coll is exhausted."
  [f coll]
  (loop [result []
         remaining coll
         idx 0]
    (if (empty? remaining)
      result
      (recur (conj result (f idx (first remaining)))
             (rest remaining)
             (inc idx)))))

;; ============================================================================
;; More Sequence Functions
;; ============================================================================

(defn take
  "Returns a vector of the first n items in coll, or all items if
  there are fewer than n."
  [n coll]
  (loop [result []
         remaining coll
         count n]
    (if (zero? count)
      result
      (if (empty? remaining)
        result
        (recur (conj result (first remaining))
               (rest remaining)
               (dec count))))))

(defn drop
  "Returns a sequence of all but the first n items in coll."
  [n coll]
  (loop [remaining coll
         count n]
    (if (zero? count)
      remaining
      (if (empty? remaining)
        remaining
        (recur (rest remaining) (dec count))))))

(defn take-while
  "Returns a vector of successive items from coll while
  (pred item) returns logical true."
  [pred coll]
  (loop [result []
         remaining coll]
    (if (empty? remaining)
      result
      (let [item (first remaining)]
        (if (pred item)
          (recur (conj result item) (rest remaining))
          result)))))

(defn drop-while
  "Returns a sequence of the items in coll starting from the first
  item for which (pred item) returns logical false."
  [pred coll]
  (loop [remaining coll]
    (if (empty? remaining)
      remaining
      (if (pred (first remaining))
        (recur (rest remaining))
        remaining))))

(defn split-at
  "Returns a vector of [(take n coll) (drop n coll)]."
  [n coll]
  [(take n coll) (drop n coll)])

(defn split-with
  "Returns a vector of [(take-while pred coll) (drop-while pred coll)]."
  [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn partition
  "Returns a vector of vectors of n items each, at offsets step
  apart. If step is not supplied, defaults to n, i.e. the partitions
  do not overlap. If a pad collection is supplied, use its elements as
  necessary to complete last partition up to n items. In case there are
  not enough padding elements, return a partition with less than n items."
  [n coll]
  (loop [result []
         remaining coll]
    (if (< (count remaining) n)
      result
      (recur (conj result (take n remaining))
             (drop n remaining)))))

(defn partition-all
  "Returns a vector of vectors like partition, but may include
  partitions with fewer than n items at the end."
  [n coll]
  (loop [result []
         remaining coll]
    (if (empty? remaining)
      result
      (recur (conj result (take n remaining))
             (drop n remaining)))))

(defn interleave
  "Returns a vector of the first item in each coll, then the second etc."
  [c1 c2]
  (loop [result []
         s1 c1
         s2 c2]
    (if (empty? s1)
      result
      (if (empty? s2)
        result
        (recur (conj (conj result (first s1)) (first s2))
               (rest s1)
               (rest s2))))))

(defn interpose
  "Returns a vector of the elements of coll separated by sep."
  [sep coll]
  (if (empty? coll)
    []
    (loop [result [(first coll)]
           remaining (rest coll)]
      (if (empty? remaining)
        result
        (recur (conj (conj result sep) (first remaining))
               (rest remaining))))))

(defn flatten
  "Takes any nested combination of sequential things (lists, vectors,
  etc.) and returns their contents as a single, flat sequence."
  [x]
  (loop [result []
         remaining (if (coll? x) x [x])]
    (if (empty? remaining)
      result
      (let [item (first remaining)]
        (if (coll? item)
          (recur result (concat item (rest remaining)))
          (recur (conj result item) (rest remaining)))))))

(defn distinct
  "Returns a vector of the elements of coll with duplicates removed.
  Returns a stateful transducer when no collection is provided."
  [coll]
  (loop [result []
         seen #{}
         remaining coll]
    (if (empty? remaining)
      result
      (let [item (first remaining)]
        (if (contains? seen item)
          (recur result seen (rest remaining))
          (recur (conj result item) (conj seen item) (rest remaining)))))))

(defn group-by
  "Returns a map of the elements of coll keyed by the result of
  f on each element. The value at each key will be a vector of the
  corresponding elements, in the order they appeared in coll."
  [f coll]
  (reduce (fn [ret x]
            (let [k (f x)]
              (assoc ret k (conj (get ret k []) x))))
          {}
          coll))

(defn frequencies
  "Returns a map from distinct items in coll to the number of times
  they appear."
  [coll]
  (reduce (fn [counts x]
            (assoc counts x (inc (get counts x 0))))
          {}
          coll))

;; ============================================================================
;; Collection Functions
;; ============================================================================

(defn select-keys
  "Returns a map containing only those entries in map whose key is in keys."
  [m ks]
  (reduce (fn [acc k]
            (if (contains? m k)
              (assoc acc k (get m k))
              acc))
          {}
          ks))

(defn zipmap
  "Returns a map with the keys mapped to the corresponding vals."
  [keys vals]
  (loop [result {}
         ks keys
         vs vals]
    (if (empty? ks)
      result
      (if (empty? vs)
        result
        (recur (assoc result (first ks) (first vs))
               (rest ks)
               (rest vs))))))

(defn merge
  "Returns a map that consists of the rest of the maps conj-ed onto
  the first. If a key occurs in more than one map, the mapping from
  the latter (left-to-right) will be the mapping in the result."
  [& maps]
  (reduce (fn [acc m]
            (reduce (fn [a kv] (assoc a (first kv) (second kv)))
                    acc
                    m))
          {}
          maps))

(defn get-in
  "Returns the value in a nested associative structure,
  where ks is a sequence of keys. Returns nil if the key
  is not present, or the not-found value if supplied."
  ([m ks]
   (get-in m ks nil))
  ([m ks not-found]
   (loop [sentinel {}
          m m
          ks (seq ks)]
     (if ks
       (let [k (first ks)
             v (get m k sentinel)]
         (if (= v sentinel)
           not-found
           (recur sentinel v (next ks))))
       m))))

(defn assoc-in
  "Associates a value in a nested associative structure, where ks is a
  sequence of keys and v is the new value and returns a new nested structure.
  If any levels do not exist, hash-maps will be created."
  [m ks v]
  (let [k (first ks)
        more (rest ks)]
    (if (empty? more)
      (assoc m k v)
      (assoc m k (assoc-in (get m k) more v)))))

(defn update
  "'Updates' a value in an associative structure, where k is a
  key and f is a function that will take the old value
  and any supplied args and return the new value, and returns a new
  structure. If the key does not exist, nil is passed as the old value."
  [m k f & args]
  (assoc m k (apply f (get m k) args)))

(defn update-in
  "'Updates' a value in a nested associative structure, where ks is a
  sequence of keys and f is a function that will take the old value
  and any supplied args and return the new value, and returns a new
  nested structure. If any levels do not exist, hash-maps will be created."
  [m ks f & args]
  (let [k (first ks)
        more (rest ks)]
    (if (empty? more)
      (assoc m k (apply f (get m k) args))
      (assoc m k (apply update-in (get m k) more f args)))))

;; ============================================================================
;; Utility Functions
;; ============================================================================

(defn complement
  "Takes a fn f and returns a fn that takes the same arguments as f,
  has the same effects, if any, and returns the opposite truth value."
  [f]
  (fn [& args]
    (not (apply f args))))

(defn juxt
  "Takes a set of functions and returns a fn that is the juxtaposition
  of those fns. The returned fn takes a variable number of args, and
  returns a vector containing the result of applying each fn to the
  args (left-to-right)."
  [& fs]
  (fn [& args]
    (mapv (fn [f] (apply f args)) fs)))

(defn fnil
  "Takes a function f, and returns a function that calls f, replacing
  a nil first argument to f with the supplied value x."
  [f x]
  (fn [a & args]
    (apply f (if (nil? a) x a) args)))

;; ============================================================================
;; Numeric Functions
;; ============================================================================

(defn abs
  "Returns the absolute value of a."
  [n]
  (if (neg? n) (- 0 n) n))

(defn min
  "Returns the least of the nums."
  ([x] x)
  ([x y] (if (< x y) x y))
  ([x y & more]
   (reduce min (min x y) more)))

(defn max
  "Returns the greatest of the nums."
  ([x] x)
  ([x y] (if (> x y) x y))
  ([x y & more]
   (reduce max (max x y) more)))

(defn sum
  "Returns the sum of all items in coll."
  [coll]
  (reduce + 0 coll))

(defn product
  "Returns the product of all items in coll."
  [coll]
  (reduce * 1 coll))

;; ============================================================================
;; Predicate Functions
;; ============================================================================

(defn some?
  "Returns true if x is not nil, false otherwise."
  [x]
  (not (nil? x)))

(defn any?
  "Returns true for any value. Useful as a predicate."
  [x]
  true)

(defn boolean
  "Coerce to boolean. Everything except false and nil is true."
  [x]
  (if x true false))

;; ============================================================================
;; String Functions
;; ============================================================================

;; str is a native function - don't shadow it here!
;; (Native str handles variadic string concatenation efficiently)

(defn print-str
  "Returns a string of the values interposed with spaces."
  [& xs]
  (apply str (interpose " " (map str xs))))

(defn println-str
  "Returns a string of the values with a trailing newline."
  [& xs]
  (str (apply print-str xs) "\n"))
